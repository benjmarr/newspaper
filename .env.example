# Copy this file to .env and edit it:  cp .env.example .env

# REQUIRED. The password for the web page. Use something long.
APP_PASSWORD=change-me-to-something-long

# Time zone for the build schedule and all displayed times.
TZ=Australia/Melbourne

# Port on your server where the paper is served (http://<server-ip>:PAPER_PORT).
PAPER_PORT=8080

# Name shown on the masthead.
PAPER_NAME=The Morning Edition

# How many nightly database backups to keep.
BACKUP_KEEP=14

# Official weather warnings RSS feed (Bureau of Meteorology, Victoria).
ALERT_FEED_URL=http://www.bom.gov.au/fwo/IDZ00059.warnings_vic.xml
